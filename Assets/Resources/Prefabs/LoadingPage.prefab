  - {fileID: 21300000, guid: be29470699652a04b87322cd88791ee1, type: 3}
  - {fileID: 21300000, guid: 46897c972412c844b89ae2608151c4ab, type: 3}
  - {fileID: 21300000, guid: a5eaf002184b4004392faf6ccfa994ba, type: 3}
  - {fileID: 21300000, guid: 219ca9e0bf4c63843a626ac5f308502e, type: 3}
  - {fileID: 21300000, guid: 55389383498c2c34b8998acda709057f, type: 3}
  - {fileID: 21300000, guid: 115458850eb476547b52bc02968b68c1, type: 3}
  - {fileID: 21300000, guid: be63e11db4f958946b820da74ff70b25, type: 3}
  - {fileID: 21300000, guid: 7a7af32292a094840b86eb0625a1f004, type: 3}
  - {fileID: 21300000, guid: cba17bb42915f36428aa629c3d84bb26, type: 3}
  - {fileID: 21300000, guid: f3354ce9890a0344fae860c64e80424a, type: 3}
  - {fileID: 21300000, guid: 0d5d95c72f711c84484df188c4db15b3, type: 3}
  - {fileID: 21300000, guid: e0da085268776124b841c059c023f9a9, type: 3}
  - {fileID: 21300000, guid: c0f19ea8c788f3f4bbc7ea7d8bf94795, type: 3}
  - {fileID: 21300000, guid: 0cbd02bb0c627cf41be3e4ccd0df3b30, type: 3}
  - {fileID: 21300000, guid: 1c657c2c29346154ab0a80b7d2110935, type: 3}
  tips:
  - text.text = "Loading";
  - "\u672C\u6E38\u620F\u4E3A\u975E\u5546\u4E1A\u6027\u8D28,\u4EFB\u4F55\u5E73\u53F0\u4E0A\u67B6\u7684\u6536\u8D39\u672C\u6E38\u620F\u8D44\u6E90\u5747\u4E0D\u662F\u672C\u6E38\u620F\u5DE5\u4F5C\u5BA4\u6210\u5458\u6240\u4E3A"
  - "\u6234\u4E0A\u8033\u673A\u4EE5\u83B7\u53D6\u6700\u4F73\u4F53\u9A8C"
  - Don't look away!
  - "\u5438\u63D2\u6B6A\u6211\u559C\u6B22\u4F60"
  - "\u6E38\u73A9\u6311\u6218\u6A21\u5F0F\uFF0C\u4F53\u9A8C\u4E0D\u4E00\u6837\u7684\u5173\u5361"
  - "\u4F60\u7684\u4F5C\u4E1A\u5199\u5B8C\u4E86\u5417\uFF1F"
  - "\u6709\u4E9B\u4F60\u4E0D\u5728\u610F\u7684\u5730\u65B9\u4F1A\u51FA\u73B0\u94BB\u77F3\u6216\u8005\u673A\u5173\u94BB\u54E6\uFF5E"
  - "\u5F53\u4F60\u5728\u6CE8\u89C6\u7740\u7EBF\u7EBF\uFF0C\u7EBF\u7EBF\u4E5F\u540C\u65F6\u5728\u6CE8\u89C6\u7740\u4F60"
  - "DLRS\u5B98\u65B9\u7F51\u7AD9 chinadlrs.com"
  - "\u5982\u679C\u5173\u5361\u5361\u987F\uFF0C\u53EF\u4EE5\u8BD5\u8BD5\u5173\u95ED\u540E\u5904\u7406"
  - "{\u821E\u7EBFFO}\u2229{\u6E38\u73A9\u5173}=\u2205"
  - "\u5982\u679C\u719F\u7EC3\u4E86\u6E38\u620F\uFF0C\u53EF\u4EE5\u8BD5\u8BD5\u9AD8\u96BE\u5EA6\u5173\u5361\uFF01"
  - "\u4F60\u8FD8\u8BB0\u5F97\u4E0A\u4E00\u6761tip\u662F\u4EC0\u4E48\u5417"
  - "\u6E6B\u6C7B\u524D\u8F88\uFF01Ciallo\uFF5E(\u2220\u30FB\u03C9< )\u2312\u2606"
  - "\u51FA\u6765\u4E86"
  - "\u51FA\u6765\u4E86"
  - "\u6211\u4EC0\u4E48\u90FD\u4E0D\u80FD\u7EC7\uFF0C\u9664\u4E86\u4F60\u7684\u5FC3"
  - There's No Tip.
  - "\u6210\u5C31\u63D0\u793A\uFF1A\u51FA\u6765\u4E86\u3002"
  - "\u5728\u67D0\u4E00\u5173\u5F00\u59CB\u65F6\u6309\u4E0B\u795E\u79D8\u6309\u94AE\u4F1A\u6709\u5947\u5999\u7684\u4E8B\u60C5\u53D1\u751F"
  - "\u5982\u679C\u9047\u5230\u51FA\u56FE\u60C5\u51B5\u53EF\u4EE5\u6309\u4E0B\u8FD4\u56DE\u6216Esc\u952E\u8131\u79BB\u5361\u6B7B"
  - "\u5177\u6709\u5F88\u5F3A\u7684\u827A\u672F\u98CE\u683C"
  - "\u5999\u8DA3\u6A2A\u751F"
  - "\u7838\u9505\u5356\u94C1"
  - "\u670D\u52A1\u5668\u901A\u8BAF\u4E2D..."
  - Milk Tea Mouse
  - "\u5EB7\u8D5B\u666E\u7279\uFF01"
  - "Ciallo\uFF5E(\u2220\u30FB\u03C9< )\u2312\u2606"
  - "\u6709bug\u8BB0\u5F97\u5728\u5B98\u7F51\u4E0A\u53CD\u9988\u54E6"
  - "\u767D\u754CII\u5E0C\u671B\u80FD\u65E9\u65E5\u4E0B\u67B6\uFF0C\u96BE\u6B7B\u4E86\uFF0C\u7ED9\u6211\u6025\u54ED\u4E86"
  - "Hi \u5C0F__ __"
  - "Hi \u5C0F\u5C0F iH"
  - "\u6CA1\u51FA\u6765"
  - "\u53E4\u9091\u65B0\u97F5\uFF0C\u7EFD\u653E__ __"
  - "\u9E21\u56DE\u773C\u7738\uFF0C__\u8700\u65B0\u97F5"
  - "\u767D\u754C2\u7834\u4E07\u64AD\u6211\u9732\u8138"
  - "T\u2014M\u2014D,\u6628\u5929\u665A\u4E0A\u62FF\u90A3\u4E2Aunity\uFF0C\u622A\u4E2A8k\u56FE\uFF0C\u70B9\u2197\u4E00\u4E0B\u90A3\u4E2A\u4E09\u89D2\u7B26\u53F7\u5B83\u76F4\u63A5\u7ED9\u6211\u5361\u6B7B\u4E86\uFF0C\u554A~\uFF0C\u6211\u505A\u4E86\u4E24\u4E2A\u5C0F\u65F6\u7684\u573A\u666F\u6CA1\u6709\u4FDD\u5B58\u2014\u2014\uFF01\uFF01\uFF01\uFF01"
  - "\u96E8\u4E2A__\u5DF4"
  - "\u4F60\u60F3\u4F55\u51FA\u600E\u6837\u7684\u610F\u5473"
  - "\u5976\u8336\u9F20\uFF01\uFF01\uFF01"
